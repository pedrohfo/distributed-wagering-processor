# Local development ONLY. Copy to .env; do not commit .env.
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=backend

PORT=3000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566
# LocalStack default account ID (adjust if setup-sqs.ts prints another URL):
SQS_INBOX_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-transactions.fifo
SQS_INBOX_DLQ_URL=http://127.0.0.1:4566/000000000000/wager-transactions-dlq.fifo
SQS_OUTBOX_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-events.fifo

# Enable in the dedicated worker terminal / process.
WORKERS_ENABLED=0
WORKER_INBOX_BATCH=10
WORKER_INBOX_WAIT_SECONDS=2
WORKER_INBOX_INTERVAL_MS=250
WORKER_OUTBOX_BATCH=10
WORKER_OUTBOX_INTERVAL_MS=500
WORKER_REFERENCE_BATCH=20
WORKER_REFERENCE_INTERVAL_MS=1000
